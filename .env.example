# Copy this file to .env and fill in your key. .env is gitignored.

# NVIDIA NIM API key. Free tier -- create an account at https://build.nvidia.com,
# open any model, click "Get API Key". It starts with "nvapi-".
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXX

# Optional: override the default chat model (meta/llama-3.3-70b-instruct).
# Any chat model available on your NIM account works.
# NIM_MODEL=meta/llama-3.3-70b-instruct
